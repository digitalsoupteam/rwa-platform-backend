{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2021",
    "verbatimModuleSyntax": true,

    /* Modules */
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["bun-types"],

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true
  }
}
